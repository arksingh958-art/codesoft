# choice avilable
choices = ["rock", "paper", "scissors"]

# score avilable
score = {"player": 0, "computer": 0}
print("="*45)
print("🎮Welcome to Rock, Paper, Scissors Game🎮")
print("="*45)
print ("instructions:")
print("-type Rock, Paper, or Scissors.")
print("-Enter 'quite' anytime to exit the game.\n")
print("="*45)

while True:
    # player input
    player_choice = input("Enter your choice: ").lower()
    
    # check if player wants to quit
    if player_choice == "quit":
        print("Thanks for playing!")
        break
    
    # check if player choice is valid
    if player_choice not in choices:
        print("Invalid choice! Please choose Rock, Paper, or Scissors.")
        continue
    
    # computer choice
    import random
    computer_choice = random.choice(choices)
    
    print(f"Computer chose: {computer_choice}")
    
    # determine winner
    if player_choice == computer_choice:
        print("It's a tie!")
    elif (player_choice == "rock" and computer_choice == "scissors") or \
         (player_choice == "paper" and computer_choice == "rock") or \
         (player_choice == "scissors" and computer_choice == "paper"):
        print("You win!")
        score["player"] += 1
    else:
        print("Computer wins!")
        score["computer"] += 1

    print(f"Score - Player: {score['player']}, Computer: {score['computer']}\n")
    # display score
    print("\nscoreboard")
    print("-"*45)
    print(f"Player: {score['player']} | Computer: {score['computer']}")
    print(f"computer:{score['computer']}")
    # play again
    play_again = input("Do you want to play again? (yes/no): ").lower()
    if play_again != "yes":
        print("Thanks for playing!")
        break